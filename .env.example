# Atlas vanilla-JS quickstart — copy to .env. Vite exposes only VITE_ vars.

# Publishable key (safe to expose). Get one at https://atlasauth.net.
VITE_ATLAS_PUBLISHABLE_KEY=pk_test_xxx

# The instance's Frontend API origin. On the hosted fleet this is the shared
# host until you verify a custom domain.
VITE_ATLAS_FRONTEND_API=https://atlasauth.net
